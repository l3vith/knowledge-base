# Copy to .env in the repo root (same folder as requirements.txt) and fill in. .env is gitignored — never commit it.

# --- OpenCode (organiser key, $10 total for the whole hackathon) ---
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1/chat/completions
LLM_MODEL=qwen3.8-flash
# Legacy judge fallback; OPENCODE_JUDGE_MODEL below takes precedence for judging only.
OPENCODE_MODEL=qwen3.8-flash
# Judge is configured independently; generation/ingestion remain Qwen with thinking disabled.
OPENCODE_JUDGE_MODEL=glm-5.3-flash
JUDGE_REASONING_EFFORT=low
ANSWER_MODEL=qwen3.8-flash
# Qwen uses the Messages endpoint and thinking.type=disabled automatically.

# Hard spend cap for ingestion AND queries (kb/llm.py sums data/spend.jsonl). Raise it deliberately, stage by stage
# (docs/CREDIT_PLAN.md). With the cap set, blank prices block every call, because the cap could not be enforced.
KB_BUDGET_USD=1.50
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.47

# KB_METADATA_NAVIGATION=1  # default: validated sections, labels, captions and bounded source references
# KB_PAGE_SELECTION=local  # default: source FTS + local vectors; llm opts back into paid card surveys
# KB_LLM_MODE=dryrun       # no network, $0: stand-in answers in the right formats with estimated token cost

# --- Langfuse (required: /query refuses to run without it unless KB_REQUIRE_LANGFUSE=0) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
KB_REQUIRE_LANGFUSE=1
KB_QUERY_DEADLINE_S=30

# --- Optional deployment (docs/DEPLOY.md) ---
# MONGODB_URI=             # Atlas: persist indexes across restarts of a free host
# KB_RERANKER=0            # skip the cross-encoder to save ~100 MB RAM on a 512 MB host

# KB_ANALYTICAL_WRITER=synthesis  # synthesis (default: cited write-up, labelled findings/interpretations/gaps) | ledger (source-ID findings) | extractive

# KB_LEDGER_EXTRACTION=integrated  # ledger default: source-ID findings in existing verification calls
# KB_LEDGER_EXTRACTION=separate    # historical separate-extraction ablation only
